#!/bin/sh
# Switch Claude Code between the ADHD output style and Kem's STE Reply Standard.
# Both live in dotfiles; this flips the pointer the hooks read and the outputStyle setting.
set -e
C=$HOME/.claude
case "$1" in
  ste)  style=default; skill=false ;;
  adhd) style="Concise (ADHD)"; skill=true ;;
  ""|-*) echo "active: $(cat "$C/active-style")"; echo "usage: claude-style [ste|adhd]"; exit 0 ;;
  *)    echo "usage: claude-style [ste|adhd]" >&2; exit 1 ;;
esac
tmp=$(mktemp)
# why: the i-have-adhd skill self-triggers on every message, so STE must switch it off
jq --arg s "$style" --argjson k "$skill" \
  '.outputStyle=$s | .enabledPlugins["i-have-adhd@i-have-adhd"]=$k' "$C/settings.json" > "$tmp"
cat "$tmp" > "$C/settings.json"   # why: cat, not mv, so the stow symlink survives
rm -f "$tmp"
printf '%s\n' "$1" > "$C/active-style"
echo "claude style -> $1 (restart Claude Code, or /clear)"
